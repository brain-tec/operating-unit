<odoo>
    <record id="ir_rule_stock_production_lot_allowed_operating_units" model="ir.rule">
        <field name="model_id" ref="stock.model_stock_production_lot" />
        <field name="domain_force">['|',
            ('product_id.operating_unit_ids', '=', False),
            ('product_id.operating_unit_ids', 'in', user.operating_unit_ids.ids)]
        </field>
        <field name="name">Lots from allowed operating units</field>
        <field name="global" eval="True" />
        <field eval="1" name="perm_unlink" />
        <field eval="1" name="perm_write" />
        <field eval="1" name="perm_read" />
        <field eval="1" name="perm_create" />
    </record>
    <record
        id="stock_operating_unit.ir_rule_stock_quant_allowed_operating_units"
        model="ir.rule"
    >
        <field name="domain_force">['|',
            ('location_id.operating_unit_id', '=', False),
            ('location_id.operating_unit_id', 'in', user.operating_unit_ids.ids),
            '|',
            ('product_id.operating_unit_ids', '=', False),
            ('product_id.operating_unit_ids', 'in', user.operating_unit_ids.ids)
            ]
        </field>
    </record>
</odoo>
